{
  "name": "luminae-helper",
  "version": "1.2.3",
  "description": "Install public AI agent skills to coding tools",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "luminae-helper": "src/cli.js"
  },
  "files": [
    "src/cli.js",
    "src/index.js",
    "src/lib/*.js",
    "src/utils/*.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node --watch src/cli.js",
    "test": "vitest run"
  },
  "keywords": [
    "claude",
    "cursor",
    "opencode",
    "trae",
    "skills",
    "ai-agent",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evenweiss/luminae-helper.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/ansi": "^2.0.5",
    "@inquirer/core": "^11.1.10",
    "@inquirer/figures": "^2.0.5",
    "@inquirer/prompts": "^8.3.0",
    "chalk": "^5.3.0",
    "gradient-string": "^3.0.0",
    "wcwidth": "^1.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "vitest": "^4.1.6"
  },
  "exports": {
    ".": "./src/index.js"
  }
}
